# Copy this file to .env and fill in real values.

# Football API (RapidAPI), read in src/extract.py 
API_KEY=your-rapidapi-key
API_HOST=your-api-host.p.rapidapi.com

# Standings endpoint
API_URL=https://your-api-host.p.rapidapi.com/path/to/standings

# League details endpoint
API_URL2=https://your-api-host.p.rapidapi.com/path/to/league-details

# PostgreSQL - read in src/load.py
host=localhost
port=5432
username=postgres
pass=your-db-password
dbname=your-db-name
